{
  "name": "dsh-clinepass",
  "version": "0.5.7",
  "private": true,
  "description": "DeepSeek Harness plugin that connects ClinePass: models, API key, and usage limits.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/build-client.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/maintenance/VALIDATION.md",
    "docs/maintenance/UPSTREAM_SYNC_PLAN.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cline",
    "clinebot",
    "clinepass",
    "openai-compatible",
    "llm-provider",
    "usage-dashboard",
    "quota-limits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangnan0811/dsh-clinepass.git"
  },
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "check:client": "node scripts/build-client.js --check",
    "lint": "eslint lib scripts test",
    "test": "npm run check:client && npm run lint && node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-rc.2",
    "@earendil-works/pi-ai": "^1.3.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "homepage": "https://github.com/xiangnan0811/dsh-clinepass#readme",
  "bugs": {
    "url": "https://github.com/xiangnan0811/dsh-clinepass/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "tar": "^7.5.22"
  }
}
